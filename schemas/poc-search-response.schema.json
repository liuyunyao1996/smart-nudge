{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-nudge.local/schemas/poc-search-response.schema.json",
  "title": "Smart Nudge grounded search response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coverage_status", "items"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "coverage_status": {"enum": ["checked", "partial", "unavailable"]},
    "items": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "publisher", "published_date", "grounded_note", "citation_urls"],
      "properties": {
        "title": {"$ref": "#/$defs/text"},
        "publisher": {"$ref": "#/$defs/text"},
        "published_date": {
          "type": ["string", "null"],
          "maxLength": 80,
          "description": "Prefer null or YYYY-MM-DD. The local converter normalizes strict ISO datetimes and degrades other values to null."
        },
        "grounded_note": {"$ref": "#/$defs/text"},
        "citation_urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri", "pattern": "^https://"}
        }
      }
    }
  }
}
