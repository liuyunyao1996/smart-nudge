{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-nudge.local/schemas/source-registry.schema.json",
  "title": "Smart Nudge P2 source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "status", "reviewed_at", "fetch_defaults", "sources"],
  "properties": {
    "registry_version": {"type": "string", "minLength": 1},
    "status": {"const": "engineering_complete_pending_organizational_approval"},
    "reviewed_at": {"type": "string", "format": "date"},
    "fetch_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["https_only", "dns_public_addresses_only", "connect_timeout_seconds", "read_timeout_seconds", "max_redirects", "max_bytes", "user_agent"],
      "properties": {
        "https_only": {"const": true},
        "dns_public_addresses_only": {"const": true},
        "connect_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "read_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "max_redirects": {"type": "integer", "minimum": 1, "maximum": 5},
        "max_bytes": {"type": "integer", "minimum": 1024, "maximum": 20971520},
        "user_agent": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "name", "organization", "market_ids", "languages", "topic_ids", "source_type", "search_mode", "trust", "access", "rights", "methods", "verification"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "organization": {"type": "string", "minLength": 1},
        "market_ids": {"$ref": "#/$defs/nonemptyStrings"},
        "languages": {"$ref": "#/$defs/nonemptyStrings"},
        "topic_ids": {"$ref": "#/$defs/nonemptyStrings"},
        "source_type": {"enum": ["regulator", "government", "company", "professional_multilateral"]},
        "search_mode": {"enum": ["trusted_registry", "open_discovery_only"]},
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "scope", "exclusions"],
          "properties": {
            "tier": {"enum": ["primary", "professional_context", "candidate"]},
            "scope": {"$ref": "#/$defs/nonemptyStrings"},
            "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "automated_content_access", "authentication", "rate_policy", "robots_review"],
          "properties": {
            "status": {"enum": ["approved_automated", "manual_review_only", "disabled"]},
            "automated_content_access": {"type": "boolean"},
            "authentication": {"enum": ["none", "not_applicable"]},
            "rate_policy": {"type": "string", "minLength": 1},
            "robots_review": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reviewed_at", "notes"],
              "properties": {
                "status": {"enum": ["reviewed", "not_retrievable", "not_applicable_api", "pending"]},
                "reviewed_at": {"type": "string", "format": "date"},
                "notes": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retention", "excerpt_retention", "fulltext_retention", "commercial_use", "attribution", "policy_urls", "notes"],
          "properties": {
            "retention": {"enum": ["approved_metadata_only", "approved_excerpt"]},
            "excerpt_retention": {"type": "string", "minLength": 1},
            "fulltext_retention": {"type": "string", "minLength": 1},
            "commercial_use": {"enum": ["allowed_with_conditions", "internal_view_only", "not_confirmed", "not_permitted_without_written_permission"]},
            "attribution": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "policy_urls": {"$ref": "#/$defs/nonemptyStrings"},
            "notes": {"type": "string", "minLength": 1}
          }
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "entry_url", "host", "path_prefixes", "content_types"],
            "properties": {
              "kind": {"enum": ["api", "rss", "html", "pdf", "manual"]},
              "entry_url": {"type": "string", "format": "uri", "pattern": "^https://"},
              "host": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
              "path_prefixes": {"$ref": "#/$defs/nonemptyStrings"},
              "content_types": {"$ref": "#/$defs/nonemptyStrings"}
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["last_verified", "verification_method", "evidence_urls", "coverage_limitations"],
          "properties": {
            "last_verified": {"type": "string", "format": "date"},
            "verification_method": {"type": "string", "minLength": 1},
            "evidence_urls": {"$ref": "#/$defs/nonemptyStrings"},
            "coverage_limitations": {"$ref": "#/$defs/nonemptyStrings"}
          }
        }
      }
    }
  }
}
