{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-nudge.local/schemas/skills/regulatory-change-output.schema.json",
  "title": "Regulatory change candidate v0.1.0",
  "description": "A structured candidate for later P4 verification and executive selection; schema validity is not factual verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_id",
    "skill_version",
    "topic_id",
    "event_type",
    "market_id",
    "issuer",
    "document_title",
    "document_status",
    "jurisdiction",
    "instrument_id",
    "publication_date",
    "effective_date",
    "consultation_deadline",
    "transition_period",
    "affected_entities",
    "affected_products",
    "affected_channels",
    "obligation_changes",
    "change_from_prior_rule",
    "exceptions",
    "business_impacts",
    "evidence_assessment",
    "unknowns",
    "recommended_disposition",
    "aia_financial_impact_quantification"
  ],
  "properties": {
    "skill_id": {"const": "regulatory-change"},
    "skill_version": {"const": "0.1.0"},
    "topic_id": {"const": "regulatory-change"},
    "event_type": {"enum": ["consultation", "final_rule", "supervisory_guidance", "enforcement", "implementation_update"]},
    "market_id": {"enum": ["HK", "CN", "MY"]},
    "issuer": {"$ref": "#/$defs/text"},
    "document_title": {"$ref": "#/$defs/text"},
    "document_status": {"enum": ["consultation", "final_rule", "supervisory_guidance", "enforcement_action", "implementation_update", "correction", "unknown"]},
    "jurisdiction": {"$ref": "#/$defs/text"},
    "instrument_id": {"$ref": "#/$defs/nullableText"},
    "publication_date": {"$ref": "#/$defs/nullableDate"},
    "effective_date": {"$ref": "#/$defs/nullableDate"},
    "consultation_deadline": {"$ref": "#/$defs/nullableDate"},
    "transition_period": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_date", "end_date", "description"],
          "properties": {
            "start_date": {"$ref": "#/$defs/nullableDate"},
            "end_date": {"$ref": "#/$defs/nullableDate"},
            "description": {"$ref": "#/$defs/text"}
          }
        }
      ]
    },
    "affected_entities": {"$ref": "#/$defs/texts"},
    "affected_products": {"$ref": "#/$defs/texts"},
    "affected_channels": {"$ref": "#/$defs/texts"},
    "obligation_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "action", "object", "timing", "exception_notes", "basis_claim_ids"],
        "properties": {
          "subject": {"$ref": "#/$defs/text"},
          "action": {"$ref": "#/$defs/text"},
          "object": {"$ref": "#/$defs/text"},
          "timing": {"$ref": "#/$defs/nullableText"},
          "exception_notes": {"$ref": "#/$defs/texts"},
          "basis_claim_ids": {"$ref": "#/$defs/ids"}
        }
      }
    },
    "change_from_prior_rule": {"$ref": "#/$defs/nullableText"},
    "exceptions": {"$ref": "#/$defs/texts"},
    "business_impacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "conditional", "assessment", "basis_claim_ids", "unknowns"],
        "properties": {
          "area": {"enum": ["licensing", "capital", "product", "distribution", "customer_protection", "operations", "governance", "reporting", "other"]},
          "conditional": {"const": true},
          "assessment": {"$ref": "#/$defs/text"},
          "basis_claim_ids": {"$ref": "#/$defs/ids"},
          "unknowns": {"$ref": "#/$defs/texts"}
        }
      }
    },
    "evidence_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "primary_document_obtained", "supporting_claim_ids", "conflicts"],
      "properties": {
        "state": {"enum": ["primary_supported", "signal_only", "conflicted", "insufficient"]},
        "primary_document_obtained": {"type": "boolean"},
        "supporting_claim_ids": {"$ref": "#/$defs/ids"},
        "conflicts": {"$ref": "#/$defs/texts"}
      }
    },
    "unknowns": {"$ref": "#/$defs/texts"},
    "recommended_disposition": {"enum": ["proceed_to_verification", "watch", "ignore"]},
    "aia_financial_impact_quantification": {"type": "null"}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "consultation"}}, "required": ["event_type"]},
      "then": {"properties": {"document_status": {"enum": ["consultation", "correction", "unknown"]}}}
    },
    {
      "if": {"properties": {"evidence_assessment": {"properties": {"primary_document_obtained": {"const": false}}, "required": ["primary_document_obtained"]}}},
      "then": {
        "properties": {
          "evidence_assessment": {"properties": {"state": {"enum": ["signal_only", "conflicted", "insufficient"]}}},
          "recommended_disposition": {"enum": ["watch", "ignore"]}
        }
      }
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "nullableText": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
    "nullableDate": {"type": ["string", "null"], "format": "date"},
    "texts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}}
  }
}
