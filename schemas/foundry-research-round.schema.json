{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-nudge.local/schemas/foundry-research-round.schema.json",
  "title": "Smart Nudge Foundry research round draft v0.1.0",
  "description": "Citation-only candidate signals for deterministic local conversion; schema validity is not factual verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coverage_status", "signals"],
  "properties": {
    "schema_version": {"enum": ["0.1.0"]},
    "coverage_status": {"enum": ["checked", "partial", "unavailable"]},
    "signals": {
      "type": "array",
      "maxItems": 7,
      "items": {"$ref": "#/$defs/signal"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "texts": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "nullableText": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
    "nullableDate": {
      "type": ["string", "null"],
      "format": "date"
    },
    "citationUrls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "statement", "kind", "citation_urls"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"},
        "statement": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["fact", "reported_allegation", "observation"]},
        "citation_urls": {"$ref": "#/$defs/citationUrls"}
      }
    },
    "obligationChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "action", "object", "timing", "exception_notes", "basis_claim_ids"],
      "properties": {
        "subject": {"$ref": "#/$defs/text"},
        "action": {"$ref": "#/$defs/text"},
        "object": {"$ref": "#/$defs/text"},
        "timing": {"$ref": "#/$defs/nullableText"},
        "exception_notes": {"$ref": "#/$defs/texts"},
        "basis_claim_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_id",
        "issuer",
        "document_title",
        "document_status",
        "jurisdiction",
        "instrument_id",
        "publication_date",
        "effective_date",
        "consultation_deadline",
        "affected_entities",
        "affected_products",
        "affected_channels",
        "obligation_changes",
        "change_from_prior_rule",
        "exceptions",
        "unknowns",
        "claims"
      ],
      "properties": {
        "signal_id": {"$ref": "#/$defs/id"},
        "issuer": {"$ref": "#/$defs/text"},
        "document_title": {"$ref": "#/$defs/text"},
        "document_status": {
          "enum": [
            "consultation",
            "final_rule",
            "supervisory_guidance",
            "enforcement_action",
            "implementation_update",
            "correction",
            "unknown"
          ]
        },
        "jurisdiction": {"$ref": "#/$defs/text"},
        "instrument_id": {"$ref": "#/$defs/nullableText"},
        "publication_date": {"$ref": "#/$defs/nullableDate"},
        "effective_date": {"$ref": "#/$defs/nullableDate"},
        "consultation_deadline": {"$ref": "#/$defs/nullableDate"},
        "affected_entities": {"$ref": "#/$defs/texts"},
        "affected_products": {"$ref": "#/$defs/texts"},
        "affected_channels": {"$ref": "#/$defs/texts"},
        "obligation_changes": {
          "type": "array",
          "maxItems": 30,
          "items": {"$ref": "#/$defs/obligationChange"}
        },
        "change_from_prior_rule": {"$ref": "#/$defs/nullableText"},
        "exceptions": {"$ref": "#/$defs/texts"},
        "unknowns": {"$ref": "#/$defs/texts"},
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"$ref": "#/$defs/claim"}
        }
      }
    }
  }
}
