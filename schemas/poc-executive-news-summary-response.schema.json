{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-nudge.local/schemas/poc-executive-news-summary-response.schema.json",
  "title": "Smart Nudge Asia executive news summary response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "executive_summary", "items"],
  "properties": {
    "schema_version": {"const": "1.3.0"},
    "title": {"$ref": "#/$defs/text"},
    "executive_summary": {"$ref": "#/$defs/text"},
    "items": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "ids": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^src-[a-f0-9]{12}$"}},
    "short_text": {"type": "string", "minLength": 1, "maxLength": 140},
    "bullets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/text"}
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_item_ids", "title", "summary", "bullet_points", "attention_level", "topic", "signal_type"],
      "properties": {
        "source_item_ids": {"$ref": "#/$defs/ids"},
        "title": {"$ref": "#/$defs/short_text"},
        "summary": {"$ref": "#/$defs/text"},
        "bullet_points": {"$ref": "#/$defs/bullets"},
        "attention_level": {"enum": ["high", "medium", "low"]},
        "topic": {"enum": ["external_environment", "government_regulatory"]},
        "signal_type": {"enum": ["aia_major_news", "final_rule", "enforcement", "consultation", "guidance", "competitor_market_move", "product_distribution", "leadership_change", "macro_market", "technology_operational_risk", "informational"]}
      }
    }
  }
}
