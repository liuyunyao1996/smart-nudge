{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-nudge.local/schemas/domain-skill.schema.json",
  "title": "Smart Nudge versioned domain skill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "version",
    "status",
    "owner",
    "review",
    "scope",
    "triggers",
    "research",
    "extraction",
    "evidence",
    "analysis",
    "guardrails",
    "output",
    "examples"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "skill_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "status": {"enum": ["draft_pending_domain_review", "approved", "retired"]},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "accountable_role"],
      "properties": {
        "function": {"type": "string", "minLength": 1},
        "accountable_role": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_reviewed_on", "next_review_on", "approval_status", "required_reviewers"],
      "properties": {
        "last_reviewed_on": {"type": "string", "format": "date"},
        "next_review_on": {"type": "string", "format": "date"},
        "approval_status": {"enum": ["engineering_only", "domain_approved", "retired"]},
        "required_reviewers": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_ids", "event_types", "market_ids"],
      "properties": {
        "topic_ids": {"$ref": "#/$defs/nonemptyStrings"},
        "event_types": {"$ref": "#/$defs/nonemptyStrings"},
        "market_ids": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {"$ref": "#/$defs/nonemptyStrings"},
        "exclude": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions", "query_templates", "multilingual_terms", "follow_up_strategy"],
      "properties": {
        "questions": {"$ref": "#/$defs/nonemptyStrings"},
        "query_templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "template", "purpose"],
            "properties": {
              "language": {"type": "string", "minLength": 1},
              "template": {"type": "string", "minLength": 1},
              "purpose": {"type": "string", "minLength": 1}
            }
          }
        },
        "multilingual_terms": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/nonemptyStrings"}
        },
        "follow_up_strategy": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "date_rules", "entity_rules"],
      "properties": {
        "required_fields": {"$ref": "#/$defs/nonemptyStrings"},
        "date_rules": {"$ref": "#/$defs/nonemptyStrings"},
        "entity_rules": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_source_requirement", "claim_rules", "insufficient_when"],
      "properties": {
        "primary_source_requirement": {"type": "string", "minLength": 1},
        "claim_rules": {"$ref": "#/$defs/nonemptyStrings"},
        "insufficient_when": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact_dimensions", "materiality_signals", "escalation_rules", "inference_rules"],
      "properties": {
        "impact_dimensions": {"$ref": "#/$defs/nonemptyStrings"},
        "materiality_signals": {"$ref": "#/$defs/nonemptyStrings"},
        "escalation_rules": {"$ref": "#/$defs/nonemptyStrings"},
        "inference_rules": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction_source", "common_misclassifications", "prohibited_inferences"],
      "properties": {
        "instruction_source": {"const": "version_controlled_local_files_only"},
        "common_misclassifications": {"$ref": "#/$defs/nonemptyStrings"},
        "prohibited_inferences": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_path", "validator"],
      "properties": {
        "schema_path": {"type": "string", "pattern": "^schemas/skills/[a-z0-9-]+\\.schema\\.json$"},
        "validator": {"const": "json_schema_plus_deterministic_rules"}
      }
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_path", "annotation_status", "required_case_types"],
      "properties": {
        "fixture_path": {"type": "string", "pattern": "^evals/skills/[a-z0-9-]+\\.synthetic\\.json$"},
        "annotation_status": {"const": "draft_pending_domain_review"},
        "required_case_types": {
          "type": "array",
          "const": ["positive", "negative", "insufficient_evidence"]
        }
      }
    }
  },
  "$defs": {
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
