{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-nudge.local/schemas/poc-rule.schema.json",
  "title": "Smart Nudge PoC rule pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_id", "version", "name", "bing", "search", "summarization"],
  "properties": {
    "schema_version": {"enum": ["1.1.0", "1.2.0"]},
    "workflow": {"enum": ["regulatory_pulse", "asia_executive_news"]},
    "rule_id": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/version"},
    "name": {"$ref": "#/$defs/text"},
    "bing": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {"required": ["instance_name", "allowed_hosts"]},
        {"required": ["configurations"]}
      ],
      "properties": {
        "instance_name": {"$ref": "#/$defs/id"},
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"}
        },
        "configurations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/bing_configuration"}
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_topic", "default_days", "results_per_query", "queries", "inclusion_rules", "exclusion_rules"],
      "properties": {
        "default_topic": {"$ref": "#/$defs/text"},
        "default_days": {"type": "integer", "minimum": 1, "maximum": 90},
        "results_per_query": {"type": "integer", "minimum": 1, "maximum": 10},
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_tool_calls_per_site", "sites"],
          "properties": {
            "max_tool_calls_per_site": {"type": "integer", "minimum": 1, "maximum": 3},
            "sites": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["site_id", "hosts"],
                "properties": {
                  "site_id": {"$ref": "#/$defs/id"},
                  "hosts": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"}
                  }
                }
              }
            }
          }
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/query"}
        },
        "inclusion_rules": {"$ref": "#/$defs/texts"},
        "exclusion_rules": {"$ref": "#/$defs/texts"}
      }
    },
    "summarization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_language", "audience", "max_items", "ranking_rules", "attention_rules", "writing_rules"],
      "properties": {
        "output_language": {"$ref": "#/$defs/text"},
        "audience": {"$ref": "#/$defs/text"},
        "max_items": {"type": "integer", "minimum": 1, "maximum": 10},
        "ranking_rules": {"$ref": "#/$defs/texts"},
        "attention_rules": {"$ref": "#/$defs/texts"},
        "writing_rules": {"$ref": "#/$defs/texts"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
    "texts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "language", "market", "set_lang", "template"],
      "properties": {
        "query_id": {"$ref": "#/$defs/id"},
        "configuration_id": {"$ref": "#/$defs/id"},
        "language": {"$ref": "#/$defs/text"},
        "market": {"$ref": "#/$defs/id"},
        "set_lang": {"$ref": "#/$defs/id"},
        "template": {"$ref": "#/$defs/text"}
      }
    },
    "bing_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_id", "instance_name", "source_tier", "sources"],
      "properties": {
        "configuration_id": {"$ref": "#/$defs/id"},
        "instance_name": {"$ref": "#/$defs/id"},
        "source_tier": {"enum": ["primary", "authoritative_media"]},
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "source_type", "market"],
            "properties": {
              "host": {"type": "string", "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"},
              "source_type": {"enum": ["regulator", "government", "central_bank", "exchange", "company", "association", "international_body", "public_media", "state_media", "media"]},
              "market": {"$ref": "#/$defs/id"}
            }
          }
        }
      }
    }
  }
}
