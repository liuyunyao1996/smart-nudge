{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-nudge.local/schemas/manual-live-research-result.schema.json",
  "title": "Smart Nudge manual live PoC intelligence result",
  "description": "Live specialization layered on the P0 intelligence-result contract; semantic validation also applies the full P0 invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_kind",
    "profile_id",
    "profile_version",
    "taxonomy_version",
    "entity_catalog_version",
    "rule_version",
    "run",
    "evidence",
    "claims",
    "events",
    "findings",
    "coverage"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "data_kind": {"const": "live"},
    "profile_id": {},
    "profile_version": {},
    "taxonomy_version": {},
    "entity_catalog_version": {},
    "rule_version": {},
    "run": {"type": "object"},
    "evidence": {"type": "array"},
    "claims": {"type": "array"},
    "events": {"type": "array"},
    "findings": {"type": "array"},
    "coverage": {"type": "array", "minItems": 1}
  }
}
