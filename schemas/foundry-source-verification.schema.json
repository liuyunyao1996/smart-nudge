{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-nudge.local/schemas/foundry-source-verification.schema.json",
  "title": "Smart Nudge original-source verification decision v0.1.0",
  "description": "Controlled claim-to-locator decisions over one transiently extracted official document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_role", "title_match", "claim_checks"],
  "properties": {
    "schema_version": {"enum": ["0.1.0"]},
    "document_role": {
      "enum": ["original_instrument", "authority_summary", "unrelated"]
    },
    "title_match": {"enum": ["exact", "compatible", "mismatch"]},
    "claim_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/claimCheck"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "locator": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
    "claimCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "relation", "locator", "rationale_code"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"},
        "relation": {"enum": ["supports", "refutes", "not_found"]},
        "locator": {"$ref": "#/$defs/locator"},
        "rationale_code": {
          "enum": ["direct_text_support", "direct_text_refutation", "no_applicable_text"]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"relation": {"const": "not_found"}}, "required": ["relation"]},
          "then": {
            "properties": {
              "locator": {"type": "null"},
              "rationale_code": {"const": "no_applicable_text"}
            }
          },
          "else": {"properties": {"locator": {"type": "string"}}}
        },
        {
          "if": {"properties": {"relation": {"const": "supports"}}, "required": ["relation"]},
          "then": {"properties": {"rationale_code": {"const": "direct_text_support"}}}
        },
        {
          "if": {"properties": {"relation": {"const": "refutes"}}, "required": ["relation"]},
          "then": {"properties": {"rationale_code": {"const": "direct_text_refutation"}}}
        }
      ]
    }
  }
}
