  "search": {
    "default_topic": "Material Asia insurance developments affecting AIA, its markets, competitors, regulation, capital, solvency or investors",
    "default_days": 14,
    "results_per_query": 10,
    "queries": [
      {
        "query_id": "regulatory-official-en",
        "configuration_id": "regulatory-official",
        "language": "English",
        "market": "asia",
        "set_lang": "en",
        "template": "{topic}; Hong Kong China Singapore Thailand Taiwan India Philippines; insurance regulation enforcement consultation policy risk capital RBC solvency commission medical repricing technology operational risk; from {date_from} to {date_to}"
      },
      {
        "query_id": "regulatory-official-zh",
        "configuration_id": "regulatory-official",
        "language": "Chinese",
        "market": "asia",
        "set_lang": "zh-hans",
        "template": "{topic}；香港 中国内地 新加坡 泰国 台湾 印度 菲律宾；保险 监管 执法 征求意见 政策 风险 资本 偿付能力 RBC 佣金 医疗调价 科技风险 营运风险；{date_from} 至 {date_to}"
      },
      {
        "query_id": "corporate-exchange-en",
        "configuration_id": "corporate-exchange",
        "language": "English",
        "market": "asia",
        "set_lang": "en",
        "template": "{topic}; AIA AXA Manulife Ping An FWD Sun Life Prudential; partnership acquisition market entry exit product distribution channel leadership capital results southbound investment; Hong Kong China Singapore Thailand Taiwan India Philippines; from {date_from} to {date_to}"
      },
      {
        "query_id": "corporate-exchange-zh",
        "configuration_id": "corporate-exchange",
        "language": "Chinese",
        "market": "asia",
        "set_lang": "zh-hans",
        "template": "{topic}；友邦 安盛 宏利 中国平安 富卫 永明 保诚；合作 收购 市场进入 退出 产品 分销 渠道 管理层 资本 业绩 南向资金；香港 中国内地 新加坡 泰国 台湾 印度 菲律宾；{date_from} 至 {date_to}"
      },
      {
        "query_id": "authoritative-media-en",
        "configuration_id": "authoritative-media",
        "language": "English",
        "market": "asia",
        "set_lang": "en",
        "template": "{topic}; AIA Asia insurance regulation enforcement competitors products partnerships leadership investment interest rates geopolitics; Hong Kong China Singapore Thailand Taiwan India Philippines; from {date_from} to {date_to}"
      },
      {
        "query_id": "authoritative-media-zh",
        "configuration_id": "authoritative-media",
        "language": "Chinese",
        "market": "asia",
        "set_lang": "zh-hans",
        "template": "{topic}；友邦 亚洲保险 监管 执法 竞争对手 产品 合作 管理层 投资 利率 地缘政治；香港 中国内地 新加坡 泰国 台湾 印度 菲律宾；{date_from} 至 {date_to}"
      }
    ],
    "inclusion_rules": [
      "Include material developments concerning AIA, insurance regulators, major competitors, market structure, products, distribution, capital, solvency, investors, financial risk, operational risk or technology risk.",
      "Cover Hong Kong, Mainland China, Singapore, Thailand, Taiwan, India and the Philippines; include regional or global developments only when a plausible transmission path to AIA or those markets is stated.",
      "Retain a candidate even when its publication date is outside the requested window or unknown; local logic decides final eligibility.",
      "Prefer the specific article, release, filing, circular or notice URL over a home page or listing page."
    ],
    "exclusion_rules": [
      "Exclude advertising, sponsored content, generic consumer advice, duplicate syndication and unrelated uses of company names.",
      "Exclude routine small-competitor news unless it signals a meaningful market, product, channel, capital or regulatory shift.",
      "Exclude general macro news without an explicit insurance-market or AIA transmission path.",
      "Do not claim private regulator engagement, unpublished feedback, or facts not supported by a native cited source."
    ]
  },
  "summarization": {
    "output_language": "English",
    "audience": "AIA Group CEO and senior executives",
    "max_items": 10,
    "ranking_rules": [
      "Rank major AIA events first, including material partnerships, acquisitions, distribution moves, leadership changes, capital events and market expansion.",
      "Next prioritize directly applicable final regulation, enforcement and material supervisory changes in AIA markets.",
      "Then prioritize structural moves by AXA, Manulife, Ping An, FWD, Sun Life, Prudential and other major competitors: market entry or exit, products, channels, partnerships, capital and regional leadership.",
      "Include macro or geopolitical developments only when the supplied source notes establish an explicit transmission path to AIA business, capital, solvency or investors.",
      "Rank candidates with specific article or release URLs above otherwise comparable homepage, category-page or listing-page citations.",
      "Use homepage or listing-page candidates only when they are materially relevant and no stronger article-level candidate covers the same development.",
      "Deprioritize small competitors, routine announcements, repeated coverage and broad daily market commentary."
    ],
    "attention_rules": [
      "High: a major AIA event, directly binding final rule or enforcement, or structural competitor move with credible material impact.",
      "Medium: a consultation, guidance, emerging risk or competitor move with a plausible but not yet direct material impact.",
      "Low: useful monitoring context whose impact is limited, indirect or uncertain.",
      "A candidate supported only by a homepage or listing-page citation cannot receive High attention.",
      "Unclear applicability must not receive High attention."
    ],
    "writing_rules": [
      "Write concise neutral executive English and distinguish facts from implications.",
      "Do not invent legal applicability, financial magnitude, implementation dates or causal impact.",
      "For every impact dimension use not_established when the supplied notes do not support a conclusion, and not_applicable only when the dimension is clearly irrelevant.",
      "Avoid repeating the same event merely because multiple sources covered it."
    ]
  }
}
